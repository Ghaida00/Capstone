# GN Backend — Environment Configuration Example
# Copy this to .env and fill in your own values.

# Server
APP_HOST=0.0.0.0
APP_PORT=3000

# ─── Credentials ───────────────────────────────────────
POSTGRES_DB=gn_db
POSTGRES_USER=gn_user
POSTGRES_PASSWORD=CHANGEME
REPL_PASSWORD=CHANGEME
REDIS_PASSWORD=CHANGEME
RABBITMQ_USER=gn_user
RABBITMQ_PASSWORD=CHANGEME
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGEME

# ─── Database Shards (3 shards) ──────────────────────
DATABASE_SHARD0_WRITE_URL=postgres://gn_user:CHANGEME@pgbouncer-shard0:5432/gn_db
DATABASE_SHARD0_READ_URLS=postgres://gn_user:CHANGEME@pg-shard0-replica1:5432/gn_db

DATABASE_SHARD1_WRITE_URL=postgres://gn_user:CHANGEME@pgbouncer-shard1:5432/gn_db
DATABASE_SHARD1_READ_URLS=postgres://gn_user:CHANGEME@pg-shard1-replica1:5432/gn_db

DATABASE_SHARD2_WRITE_URL=postgres://gn_user:CHANGEME@pgbouncer-shard2:5432/gn_db
DATABASE_SHARD2_READ_URLS=postgres://gn_user:CHANGEME@pg-shard2-replica1:5432/gn_db

DB_WRITE_POOL_SIZE=15
DB_READ_POOL_SIZE=25

# ─── Redis HA ─────────────────────────────────────────
REDIS_URL=redis://:CHANGEME@redis-master:6379
REDIS_READ_URL=redis://:CHANGEME@redis-replica:6379
REDIS_POOL_SIZE=50

# ─── RabbitMQ ─────────────────────────────────────────
RABBITMQ_URL=amqp://gn_user:CHANGEME@rabbitmq:5672

# ─── CORS ─────────────────────────────────────────────
# Comma-separated origins. Use "*" for development.
CORS_ALLOWED_ORIGINS=*

# ─── Authentication ───────────────────────────────────
# Set to true to enable JWT auth. Default: false.
ENABLE_AUTH=false
# AUTH_SECRET=your-secret-key-here

# ─── Rate Limiting ────────────────────────────────────
RATE_LIMIT_PER_SECOND=10000
RATE_LIMIT_BURST=20000

# ─── Circuit Breaker ──────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=50
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECS=10

# ─── Backpressure ─────────────────────────────────────
MAX_CONCURRENT_REQUESTS=20000

# ─── Logging ──────────────────────────────────────────
RUST_LOG=warn
