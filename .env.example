# Peakload Capstone — Environment Configuration Example
# Copy this to .env and fill in your own values.

# Server
APP_HOST=0.0.0.0
APP_PORT=3000

# ─── Credentials ───────────────────────────────────────
# Patroni creates three roles on first-boot of each shard:
#   * POSTGRES_USER     — application DB user (app + pgBouncer)
#   * postgres          — superuser, reset to POSTGRES_SUPERUSER_PASSWORD
#   * replicator        — internal role Patroni uses for
#                         streaming replication between the
#                         two nodes of each shard
# All three passwords are MANDATORY. Keep the superuser and
# replicator secrets out of the app's DATABASE_* URLs — they
# are only read by the Patroni entrypoint.
POSTGRES_DB=peakload_db
POSTGRES_USER=peakload_user
POSTGRES_PASSWORD=CHANGEME
POSTGRES_SUPERUSER_PASSWORD=CHANGEME_SUPERUSER
REPL_PASSWORD=CHANGEME_REPL
REDIS_PASSWORD=CHANGEME
RABBITMQ_USER=peakload_user
RABBITMQ_PASSWORD=CHANGEME
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGEME

# ─── Database Shards (2 shards — shard 2 disabled) ────
# WRITE URLS — point at the per-shard pgBouncer, which in
# turn points at pg-haproxy. HAProxy forwards to whichever
# node in the shard is currently primary (Patroni decides
# the role via etcd leader-lock). Hostnames below are
# therefore stable across failovers; do not change them.
#
# Shard 2 is currently commented out for resource
# conservation. Re-enable it in lockstep with the
# "shard 2 disabled" markers across docker-compose.yml,
# haproxy/haproxy.cfg, db/bootstrap/bootstrap-schema.sh,
# crates/shared_kernel/src/db/shard.rs, and
# crates/app/src/bootstrap.rs.
DATABASE_SHARD0_WRITE_URL=postgres://peakload_user:CHANGEME@pgbouncer-shard0:5432/peakload_db
DATABASE_SHARD1_WRITE_URL=postgres://peakload_user:CHANGEME@pgbouncer-shard1:5432/peakload_db
# DATABASE_SHARD2_WRITE_URL=postgres://peakload_user:CHANGEME@pgbouncer-shard2:5432/peakload_db

# READ URLS — comma-separated list per shard. Both nodes
# of a shard are listed because roles flip on failover; the
# Rust DatabasePool runs health-aware round-robin across
# them and falls back to the writer pool if every entry is
# unhealthy. See src/db/pool.rs.
#
# Note: after a failover, one of these nodes is temporarily
# the primary. Reads against a primary still succeed — you
# just lose the replica read-scaling benefit until the old
# primary rejoins as standby.
DATABASE_SHARD0_READ_URLS=postgres://peakload_user:CHANGEME@pg-shard0-node-a:5432/peakload_db,postgres://peakload_user:CHANGEME@pg-shard0-node-b:5432/peakload_db
DATABASE_SHARD1_READ_URLS=postgres://peakload_user:CHANGEME@pg-shard1-node-a:5432/peakload_db,postgres://peakload_user:CHANGEME@pg-shard1-node-b:5432/peakload_db
# DATABASE_SHARD2_READ_URLS=postgres://peakload_user:CHANGEME@pg-shard2-node-a:5432/peakload_db,postgres://peakload_user:CHANGEME@pg-shard2-node-b:5432/peakload_db

DB_WRITE_POOL_SIZE=15
DB_READ_POOL_SIZE=25

# ─── Redis HA ─────────────────────────────────────────
REDIS_URL=redis://:CHANGEME@redis-master:6379
REDIS_READ_URL=redis://:CHANGEME@redis-replica:6379
REDIS_POOL_SIZE=50

# ─── Redis Failover (Sentinel-aware) ──────────────────
# When REDIS_SENTINEL_NODES is set, the app resolves the current master
# via Sentinel on startup AND polls every REDIS_SENTINEL_MONITOR_INTERVAL_SECS
# seconds. When Sentinel promotes a new master, the app rebuilds its
# write pool automatically. Leave empty to disable Sentinel and connect
# directly to REDIS_URL (no automatic failover).
REDIS_SENTINEL_NODES=redis://redis-sentinel-1:26379,redis://redis-sentinel-2:26379,redis://redis-sentinel-3:26379
REDIS_SENTINEL_MASTER_NAME=peakload-master
REDIS_SENTINEL_MONITOR_INTERVAL_SECS=5

# ─── Postgres Failover ────────────────────────────────
# Per-replica health probe interval (background task flips read-pool
# health flags so reader() skips dead replicas).
DB_HEALTH_CHECK_INTERVAL_SECS=5

# Retry policy for transient write errors. Must cover the
# Patroni promotion window end-to-end, which is:
#   etcd lease expire (~ttl/2) + pg_promote() (~1s)
#   + HAProxy flip (~4s)                  = ~10s typical
# Default schedule below: 6 attempts × backoff_ms × attempt
# = 200 + 400 + 600 + 800 + 1000 + 1200 ≈ 4.2 s of wait.
# For requests that outlast the window the client returns 5xx
# and the HTTP caller retries. Tune these if
# `patronictl --watch 2 list peakload-shardN` reports
# consistently longer promotions.
DB_WRITE_RETRY_MAX_ATTEMPTS=6
DB_WRITE_RETRY_BACKOFF_MS=200

# ─── RabbitMQ ─────────────────────────────────────────
RABBITMQ_URL=amqp://peakload_user:CHANGEME@rabbitmq:5672

# ─── CORS ─────────────────────────────────────────────
# Comma-separated origins. Use "*" for development.
CORS_ALLOWED_ORIGINS=*

# ─── Authentication ───────────────────────────────────
# Set to true to enable JWT auth. Default: false.
ENABLE_AUTH=false
# AUTH_SECRET=your-secret-key-here

# ─── Rate Limiting ────────────────────────────────────
RATE_LIMIT_PER_SECOND=10000
RATE_LIMIT_BURST=20000

# ─── Circuit Breaker ──────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=50
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECS=10

# ─── Backpressure ─────────────────────────────────────
MAX_CONCURRENT_REQUESTS=20000

# ─── Logging ──────────────────────────────────────────
RUST_LOG=warn
