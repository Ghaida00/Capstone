# .env.example — Copy to .env and customize
# cp .env.example .env

# ─── Application ────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=3000
RUST_LOG=info,gn_backend=debug,tower_http=debug,sqlx=warn

# ─── Database Shards (3 shards) ─────────────────────────────
# Shard 0
DATABASE_SHARD0_WRITE_URL=postgres://gn_user:gn_secure_pass@pgbouncer-shard0:5432/gn_db
DATABASE_SHARD0_READ_URLS=postgres://gn_user:gn_secure_pass@pg-shard0-replica1:5432/gn_db

# Shard 1
DATABASE_SHARD1_WRITE_URL=postgres://gn_user:gn_secure_pass@pgbouncer-shard1:5432/gn_db
DATABASE_SHARD1_READ_URLS=postgres://gn_user:gn_secure_pass@pg-shard1-replica1:5432/gn_db

# Shard 2
DATABASE_SHARD2_WRITE_URL=postgres://gn_user:gn_secure_pass@pgbouncer-shard2:5432/gn_db
DATABASE_SHARD2_READ_URLS=postgres://gn_user:gn_secure_pass@pg-shard2-replica1:5432/gn_db

# ─── Connection Pool Sizes (per shard) ──────────────────────
DB_WRITE_POOL_SIZE=15
DB_READ_POOL_SIZE=25

# ─── Timeouts (seconds) ────────────────────────────────────
DB_QUERY_TIMEOUT_SECS=5
REDIS_COMMAND_TIMEOUT_SECS=3
API_TIMEOUT_SECS=30

# ─── Redis HA ──────────────────────────────────────────────
REDIS_URL=redis://:gn_redis_pass@redis-master:6379
REDIS_READ_URL=redis://:gn_redis_pass@redis-replica:6379
REDIS_POOL_SIZE=50

# ─── RabbitMQ ──────────────────────────────────────────────
RABBITMQ_URL=amqp://gn_user:gn_secure_pass@rabbitmq:5672

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_PER_SECOND=10000
RATE_LIMIT_BURST=20000

# ─── Circuit Breaker ──────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=50
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECS=10

# ─── Backpressure ─────────────────────────────────────────
MAX_CONCURRENT_REQUESTS=20000

# ─── Environment ───────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://gn-jaeger:4317
OTEL_SERVICE_NAME=gn-backend