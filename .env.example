# .env.example — Copy to .env and customize
# cp .env.example .env

# ─── Application ────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=3000
RUST_LOG=info,gn_backend=debug,tower_http=debug,sqlx=warn

# ─── PostgreSQL Primary (Write) ────────────────────────────
DATABASE_WRITE_URL=postgres://gn_user:gn_secure_pass@pgbouncer:5432/gn_db

# ─── PostgreSQL Replica (Read) ─────────────────────────────
DATABASE_READ_URL=postgres://gn_user:gn_secure_pass@postgres-replica:5432/gn_db

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── RabbitMQ ───────────────────────────────────────────────
RABBITMQ_URL=amqp://gn_user:gn_secure_pass@rabbitmq:5672

# ─── Connection Pool Sizes ──────────────────────────────────
DB_WRITE_POOL_SIZE=25
DB_READ_POOL_SIZE=50
REDIS_POOL_SIZE=50

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_PER_SECOND=5000
RATE_LIMIT_BURST=10000

# ─── Circuit Breaker ───────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=50
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECS=30

# ─── Backpressure ──────────────────────────────────────────
MAX_CONCURRENT_REQUESTS=5000
