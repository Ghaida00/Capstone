# ============================================================
# nginx.conf TEMPLATE (OPS-2 / S-5)
# ============================================================
# Rendered at container start by the official nginx image's
# built-in envsubst step (files in /etc/nginx/templates/*.template
# with NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx). Only variables that
# exist in the container environment are substituted — nginx
# runtime vars ($binary_remote_addr, $server_name, $host, …) are
# left untouched because they are not env vars.
#
# Rate-limit knobs (safe defaults set in docker-compose.yml via
# ${VAR:-default}; benchmarks override by exporting the high
# value, e.g. in .env or the shell, before `docker compose up`):
#
#   NGINX_PER_IP_RATE    per-IP req/s   (safe 2000  | bench 50000)
#   NGINX_GLOBAL_RATE    global req/s   (safe 50000 | bench 100000)
#   NGINX_PER_IP_BURST   per-IP burst   (safe 2000  | bench 10000)
#   NGINX_GLOBAL_BURST   global burst   (safe 10000 | bench 50000)
#
# The edge limiter is the first line of abuse defence (OWASP
# API4:2023). Shipping the bench value as the default is
# "dangerous defaults, safe overrides" — the edge ends up
# effectively off in every environment where someone forgot to
# swap it back, which is the normal case. The default is now the
# production-safe value; load tests opt INTO the high ceiling
# explicitly.
# ============================================================

worker_processes auto;
worker_rlimit_nofile 65535;

events {
    worker_connections 16384;
    multi_accept on;
    use epoll;
}

http {
    # ─── Performance ─────────────────────────────────────
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    keepalive_requests 10000;
    types_hash_max_size 2048;

    # MIME types: needed by the /dashboard/ location which serves
    # static files directly. The proxied API locations don't rely on
    # this (the upstream Rust app sets Content-Type itself), which is
    # why the include was never required before adding the dashboard.
    # Without it, nginx defaults every static file to text/plain and
    # browsers reject CSS/JS under strict MIME checking + nosniff.
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # ─── Buffers ─────────────────────────────────────────
    client_body_buffer_size 16k;
    client_max_body_size 8m;
    proxy_buffering on;
    proxy_buffer_size 8k;
    proxy_buffers 16 8k;
    proxy_busy_buffers_size 16k;

    # Compression off at proxy level (edge responsibility)
    gzip off;

    # ─── Response Cache ──────────────────────────────────
    proxy_cache_path /tmp/nginx_cache levels=1:2 keys_zone=api_cache:10m max_size=100m inactive=2s;

    # ─── Edge Security Headers (S-4) ────────────────────
    # Free defence-in-depth layer. `always` makes the header
    # ride error responses too. HSTS is a no-op under the current
    # plain-HTTP `listen 80` but costs nothing and prevents a
    # regression when TLS lands. Frame-ancestors + X-Frame-Options
    # are double-belted: legacy browsers honour the latter, modern
    # ones the former. `default-src 'none'` is correct for a
    # JSON-only API (no UI to break).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # ─── Rate Limiting Zones (OPS-2 / S-5) ──────────────
    # Values come from the environment (see the template header).
    # Default is the production-safe ceiling; benchmarks export
    # the high value explicitly rather than the config shipping
    # it as the default.
    limit_req_zone $binary_remote_addr zone=per_ip:20m rate=${NGINX_PER_IP_RATE}r/s;
    limit_req_zone $server_name zone=global:2m rate=${NGINX_GLOBAL_RATE}r/s;
    limit_conn_zone $binary_remote_addr zone=conn_per_ip:10m;
    limit_req_status 429;
    limit_conn_status 429;

    # ─── Logging ────────────────────────────────────────
    access_log off;
    error_log /var/log/nginx/error.log error;

    # ─── Upstream ───────────────────────────────────────
    upstream rust_backend {
        least_conn;
        server app:3000 max_fails=3 fail_timeout=10s;
        keepalive 128;
        keepalive_timeout 60s;
        keepalive_requests 10000;
    }

    # ─── Server ─────────────────────────────────────────
    server {
        listen 80;
        http2 on;
        server_name _;

        error_page 429 = @rate_limited;
        location @rate_limited {
            default_type application/json;
            return 429 '{"error":"rate_limited","message":"Too many requests"}';
        }

        # Health (no rate limit, no cache)
        location = /health {
            proxy_pass http://rust_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }

        # Metrics (no rate limit, no cache)
        location = /metrics {
            proxy_pass http://rust_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }

        # GET API routes (cached 1s, rate limited)
        location ~ ^/api/v2/transactions$ {
            limit_req zone=per_ip burst=${NGINX_PER_IP_BURST} nodelay;
            limit_req zone=global burst=${NGINX_GLOBAL_BURST} nodelay;
            limit_conn conn_per_ip 5000;

            # Cache GET responses for 1 second
            proxy_cache api_cache;
            proxy_cache_valid 200 1s;
            proxy_cache_methods GET;
            proxy_cache_key "$request_method$request_uri";
            add_header X-Cache-Status $upstream_cache_status;

            proxy_pass http://rust_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Request-ID $request_id;

            proxy_connect_timeout 3s;
            proxy_send_timeout 15s;
            proxy_read_timeout 15s;

            proxy_next_upstream error timeout http_502 http_503;
            proxy_next_upstream_tries 2;
            proxy_next_upstream_timeout 5s;
        }

        # All other API routes (no cache, rate limited)
        location /api/ {
            limit_req zone=per_ip burst=${NGINX_PER_IP_BURST} nodelay;
            limit_req zone=global burst=${NGINX_GLOBAL_BURST} nodelay;
            limit_conn conn_per_ip 5000;

            # Stream request body directly to upstream, do not buffer to disk
            proxy_request_buffering off;

            proxy_pass http://rust_backend;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Request-ID $request_id;

            proxy_connect_timeout 3s;
            proxy_send_timeout 15s;
            proxy_read_timeout 15s;

            proxy_next_upstream error timeout http_502 http_503;
            proxy_next_upstream_tries 2;
            proxy_next_upstream_timeout 5s;
        }

        # Optional per-feature location blocks live in
        # /etc/nginx/server.d/. The base image ships no such directory;
        # the dashboard mounts one via docker-compose.dashboard.yml.
        # Empty dir = no-op, so the base bring-up needs no edits to
        # enable / disable feature locations.
        include /etc/nginx/server.d/*.conf;

        location / {
            return 404 '{"error":"not_found","message":"Route not found"}';
            default_type application/json;
        }
    }
}
