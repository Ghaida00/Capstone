  "links": [],
  "panels": [
    {
      "title": "📊 System Overview",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "title": "Request Rate",
      "description": "HTTP requests per second across all app replicas",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[30s]))",
          "legendFormat": "Total",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{status=\"200\"}[30s]))",
          "legendFormat": "200 OK",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_requests_total{status=\"202\"}[30s]))",
          "legendFormat": "202 Accepted",
          "refId": "C"
        },
        {
          "expr": "sum(rate(http_requests_total{status=~\"4..\"}[30s]))",
          "legendFormat": "4xx Errors",
          "refId": "D"
        },
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[30s]))",
          "legendFormat": "5xx Errors",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        }
      }
    },
    {
      "title": "Response Time (p50 / p90 / p99)",
      "description": "HTTP latency percentiles from all app replicas",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "avg(http_request_duration_seconds{quantile=\"0.5\"})",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "avg(http_request_duration_seconds{quantile=\"0.9\"})",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "avg(http_request_duration_seconds{quantile=\"0.99\"})",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        }
      }
    },
    {
      "title": "Error Rate",
      "description": "Percentage of requests resulting in 4xx/5xx errors",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"[45]..\"}[30s])) / sum(rate(http_requests_total[30s])) * 100",
          "legendFormat": "Error %",
          "refId": "A"
        },
        {
          "expr": "sum(rate(rate_limited_total[30s])) / sum(rate(http_requests_total[30s])) * 100",
          "legendFormat": "Rate Limited %",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true
