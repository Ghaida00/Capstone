{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "📊 System Overview",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "title": "Request Rate",
      "description": "HTTP requests per second across all app replicas (excludes /health and /metrics scrape traffic)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{url_path!~\"/health|/metrics\"}[$__rate_interval]))",
          "legendFormat": "Total",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{http_response_status_code=\"200\",url_path!~\"/health|/metrics\"}[$__rate_interval]))",
          "legendFormat": "200 OK",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_requests_total{http_response_status_code=\"202\",url_path!~\"/health|/metrics\"}[$__rate_interval]))",
          "legendFormat": "202 Accepted",
          "refId": "C"
        },
        {
          "expr": "sum(rate(http_requests_total{http_response_status_code=~\"4..\",url_path!~\"/health|/metrics\"}[$__rate_interval]))",
          "legendFormat": "4xx Errors",
          "refId": "D"
        },
        {
          "expr": "sum(rate(http_requests_total{http_response_status_code=~\"5..\",url_path!~\"/health|/metrics\"}[$__rate_interval]))",
          "legendFormat": "5xx Errors",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        }
      }
    },
    {
      "title": "Response Time (p50 / p90 / p99)",
      "description": "Fleet-aggregate HTTP request latency percentiles via histogram_quantile() over the cross-replica bucket sum. This is the correct way to combine histogram quantiles across replicas (summing buckets is associative; averaging quantiles is not).",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.9, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        }
      }
    },
    {
      "title": "Error Rate",
      "description": "4xx (client fault) and 5xx (server fault) split. Thresholds apply to 5xx only — 4xx during load tests is normal (validation, idempotency conflict).",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{http_response_status_code=~\"5..\",url_path!~\"/health|/metrics\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{url_path!~\"/health|/metrics\"}[$__rate_interval])), 0.001) * 100",
          "legendFormat": "5xx %",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{http_response_status_code=~\"4..\",url_path!~\"/health|/metrics\"}[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{url_path!~\"/health|/metrics\"}[$__rate_interval])), 0.001) * 100",
          "legendFormat": "4xx %",
          "refId": "B"
        },
        {
          "expr": "sum(rate(rate_limited_total[$__rate_interval])) / clamp_min(sum(rate(http_requests_total{url_path!~\"/health|/metrics\"}[$__rate_interval])), 0.001) * 100",
          "legendFormat": "Rate Limited %",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "5xx %"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx %"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Rate Limited %"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      }
    },
