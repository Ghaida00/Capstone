# Auto-detect text files and normalize line endings
* text=auto

# Force LF for files that must run on Linux (Docker containers)
*.sh text eol=lf
*.sql text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Binary files — do not modify
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
