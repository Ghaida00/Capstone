# ─── Build Artifacts ────────────────────────────────────────
/target/
**/*.rs.bk
*.pdb

# ─── Environment ────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Docker ─────────────────────────────────────────────────
docker-compose.override.yml

# ─── IDE / Editor ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── OS ─────────────────────────────────────────────────────
*.exe
*.dll
*.so
*.dylib

# ─── Test / Coverage ───────────────────────────────────────
lcov.info
tarpaulin-report.html
coverage/

# ─── Logs ───────────────────────────────────────────────────
*.log
logs/

# ─── k6 output ──────────────────────────────────────────────
# Destination for `k6 run --summary-export=k6/output/<name>.json`.
# Ignore the generated summaries but keep the directory itself so it
# exists on a fresh checkout (k6 does not create a missing
# --summary-export directory).
k6/output/*
!k6/output/.gitkeep
*.json.gz

# ─── Docs ─────────────────────────────────────────────────
docs/audit/
docs/codemap/
docs/superpowers/

# ─── Diagnostics — keep tooling, ignore captured results ──
# Scripts and analysis docs are tracked; per-run artifacts
# (matrix logs, latency samples, stats CSVs) stay local.
diag/*
!diag/*.ps1
!diag/*.sh
!diag/*.md

# ─── Scratch / throwaway ──────────────────────────────────
.tmp-*
.env.bak

# ─── Cloud deploy (local-only, not committed) ─────────────
deploy/cloud/