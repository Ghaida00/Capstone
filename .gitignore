# ─── Build Artifacts ────────────────────────────────────────
/target/
**/*.rs.bk
*.pdb

# ─── Environment ────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Docker ─────────────────────────────────────────────────
docker-compose.override.yml

# ─── IDE / Editor ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── OS ─────────────────────────────────────────────────────
*.exe
*.dll
*.so
*.dylib

# ─── Test / Coverage ───────────────────────────────────────
lcov.info
tarpaulin-report.html
coverage/

# ─── Logs ───────────────────────────────────────────────────
*.log
logs/

# ─── k6 output ──────────────────────────────────────────────
# Ignore generated summaries but keep the directory itself — k6's
# handleSummary does not create missing output dirs, so the write
# target must exist on a fresh checkout (see k6/lib/summary.js).
k6/output/*
!k6/output/.gitkeep
*.json.gz

# ─── Docs ─────────────────────────────────────────────────
docs/audit/
docs/codemap/
docs/superpowers/

# ─── Scratch / throwaway ──────────────────────────────────
.tmp-*

# ─── Cloud deploy (local-only, not committed) ─────────────
deploy/cloud/